#!/usr/bin/env bash
set -euo pipefail

# Auto-format shell scripts with shfmt before they land.
# Enable once per clone with:  git config core.hooksPath .githooks

if ! command -v shfmt >/dev/null 2>&1; then
	echo "pre-commit: 'shfmt' not found; skipping auto-format." >&2
	exit 0
fi

# Staged, added/copied/modified/renamed files only (NUL-separated).
SCRIPTS=()
while IFS= read -r -d '' file; do
	case "$file" in
	.git/*) ;;
	*.sh)
		SCRIPTS+=("$file")
		;;
	*)
		if [ -f "$file" ] && sed -n '1p' "$file" | grep -qE '^#!.*(bash|sh)([[:space:]]|$)'; then
			SCRIPTS+=("$file")
		fi
		;;
	esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

[ "${#SCRIPTS[@]}" -eq 0 ] && exit 0

for file in "${SCRIPTS[@]}"; do
	# Respect partial staging: if a file has both staged and unstaged
	# changes, reformatting would also drag the unstaged ones in. Skip it
	# so the commit never includes changes the user didn't stage.
	if ! git diff --quiet -- "$file"; then
		echo "pre-commit: skipping '$file': partially staged. Stage it fully, or run 'shfmt -w -- $file' yourself." >&2
		continue
	fi
	shfmt -w -- "$file" || {
		echo "pre-commit: shfmt failed on '$file'." >&2
		exit 1
	}
	if ! git diff --quiet -- "$file"; then
		echo "pre-commit: reformatted '$file' with shfmt." >&2
		git add -- "$file"
	fi
done
