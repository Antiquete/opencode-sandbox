#!/usr/bin/env bash
set -euo pipefail

PROJECT="$(cd -P "$PWD" && pwd)"
HOME_DIR="$(cd -P "$HOME" && pwd)"

IMAGE="ghcr.io/anomalyco/opencode:latest"

STATE_DIR="$PROJECT/.opencode"
CONFIG_DIR="$HOME/.config/opencode"

NETWORK=""
OPENCODE_ARGS=()
while [ "$#" -gt 0 ]; do
    case "$1" in
        --docker-network)
            if [ "$#" -lt 2 ]; then
                echo "Error: --docker-network requires a value."
                exit 1
            fi
            NETWORK="$2"
            shift 2
            ;;
        --docker-network=*)
            NETWORK="${1#*=}"
            shift
            ;;
        *)
            OPENCODE_ARGS+=("$1")
            shift
            ;;
    esac
done

if [ "$PROJECT" = "/" ]; then
    echo "Error: refusing to run OpenCode at the filesystem root."
    exit 1
fi
if [ "$HOME_DIR" = "$PROJECT" ] || { case "$HOME_DIR" in "$PROJECT"/*) true;; *) false;; esac; }; then
    echo "Error: refusing to run OpenCode here:"
    echo "  $PROJECT"
    echo "It contains your home directory ($HOME_DIR), which would be exposed"
    echo "to the sandbox. Run it inside a more specific project directory."
    exit 1
fi

if [ ! -d "$PROJECT/.opencode" ]; then
    echo "Error: this directory has not been initialized for isolated OpenCode."
    echo
    echo "Run:"
    echo "  opencode-project-init"
    exit 1
fi

RESOLVED_STATE="$(cd -P "$STATE_DIR" 2>/dev/null && pwd || true)"
if [ -z "$RESOLVED_STATE" ]; then
    echo "Error: state directory is missing or unreadable:"
    echo "  $STATE_DIR"
    exit 1
fi
case "$RESOLVED_STATE" in
    "$PROJECT"/*)
        ;;
    *)
        echo "Error: state directory resolves outside the project."
        echo "  Logical:   $STATE_DIR"
        echo "  Resolved:  $RESOLVED_STATE"
        echo "Remove the symlink so it stays inside the project."
        exit 1
        ;;
esac
STATE_DIR="$RESOLVED_STATE"

if [ "${BASH_VERSION:-}" = "" ]; then
    echo "Error: this script requires bash (shebang: #!/usr/bin/env bash)."
    exit 1
fi

if ! command -v docker >/dev/null 2>&1; then
    echo "Error: the 'docker' CLI was not found."
    echo "Install Docker and make sure it is in your PATH."
    exit 1
fi

if ! docker info >/dev/null 2>&1; then
    echo "Error: cannot reach the Docker daemon."
    echo "Is Docker running? Check with: docker info"
    exit 1
fi

for path in "$PROJECT" "$CONFIG_DIR"; do
    case "$path" in
        *,*)
            echo "Error: Docker --mount cannot parse ',' inside paths:"
            echo "  $path"
            echo "Move the project or config so no path component contains a comma."
            exit 1
            ;;
    esac
done

mkdir -p "$CONFIG_DIR"

B=; DIM=; GRN=; YEL=; RED=; RST=
if [ -t 0 ] && [ -t 1 ]; then
    B=$'\033[1m'; DIM=$'\033[2m'; GRN=$'\033[32m'; YEL=$'\033[33m'; RED=$'\033[31m'; RST=$'\033[0m'
fi

NET_LABEL="${NETWORK:-Docker default network}"
ARG_LABEL="(none)"
if [ "${#OPENCODE_ARGS[@]}" -gt 0 ]; then
    ARG_LABEL="${OPENCODE_ARGS[*]}"
fi

echo
echo "${B}==========================================================${RST}"
echo "${B}  OpenCode Isolated Sandbox${RST}"
echo "${B}==========================================================${RST}"
echo
printf '  %-17s %s\n' "${B}Project${RST}" "$PROJECT"
printf '  %-17s %s\n' "${B}Network${RST}" "$NET_LABEL"
printf '  %-17s %s\n' "${B}Forwarding${RST}" "$ARG_LABEL"
echo
printf '  %-17s %s\n' "${GRN}read/write${RST}" "everything in $PROJECT"
printf '  %-17s %s\n' "${YEL}persistent${RST}" "$STATE_DIR"
printf '  %-17s %s\n' "${YEL}config${RST}" "$CONFIG_DIR"
echo
printf '  %-17s %s\n' "${RED}blocked${RST}" "other projects, your home dir, ~/.ssh, Docker socket"
echo
echo "  ${DIM}Limits: 8G RAM | 4 CPUs | 512 processes${RST}"
echo
printf "Continue? [y/N]: "
if ! read -r CONFIRM; then
    echo
    echo "Cancelled."
    exit 0
fi

case "$CONFIRM" in
    y|Y|yes|Yes|YES)
        ;;
    *)
        echo "Cancelled."
        exit 0
        ;;
esac

PROJ_SLUG="$(basename "$PROJECT" \
    | tr -cs '[:alnum:]' '-' \
    | sed 's/^-//;s/-$//' \
    | cut -c1-40)"
PROJ_HASH="$(printf '%s' "$PROJECT" | cksum | cut -d' ' -f1)"
CONTAINER_NAME="opencode-${PROJ_SLUG}-${PROJ_HASH}"

if [ -n "$NETWORK" ] && ! docker network inspect "$NETWORK" >/dev/null 2>&1; then
    echo "Docker network '$NETWORK' missing - creating it..."
    docker network create "$NETWORK" >/dev/null
fi

NET_OPTS=()
if [ -n "$NETWORK" ]; then
    NET_OPTS=(--network "$NETWORK")
fi

TTY_OPTS=(-i)
if [ -t 0 ] && [ -t 1 ]; then
    TTY_OPTS+=(-t)
fi

docker run --rm \
    "${TTY_OPTS[@]}" \
    --pull always \
    --name "$CONTAINER_NAME" \
    --cap-drop ALL \
    --security-opt no-new-privileges:true \
    --pids-limit 512 \
    --memory 8g \
    --cpus 4 \
    --mount "type=bind,src=$PROJECT,dst=/workspace" \
    --mount "type=bind,src=$STATE_DIR,dst=/root/.local/share/opencode" \
    --mount "type=bind,src=$CONFIG_DIR,dst=/root/.config/opencode" \
    --workdir /workspace \
    "${NET_OPTS[@]}" \
    "$IMAGE" \
    "${OPENCODE_ARGS[@]}"
