#!/usr/bin/env bash
set -euo pipefail
umask 077

# --------------------------------------------------------------------------
# -------------------------------- Helpers ---------------------------------
# --------------------------------------------------------------------------
# True when a path is another path or lives inside it.
within() {
	[ "$1" = "$2" ] || [[ "$1" == "$2/"* ]]
}

# Explain the gVisor requirement and stop.
gvisor_requires_docker() {
	echo "Error: --gvisor needs Docker with a runtime registered under the exact name 'runsc'."
	echo "Install gVisor and add \"runsc\" to the runtimes in /etc/docker/daemon.json,"
	echo "then run again without --runtime podman."
	exit 1
}

# True when a container runtime is installed and its daemon answers.
usable() {
	command -v "$1" >/dev/null 2>&1 && "$1" info >/dev/null 2>&1
}

# True when the runtime is rootless; stop if its identity query fails.
rootless() {
	local INFO
	if [[ $1 == docker ]] && INFO=$(docker info --format '{{json .SecurityOptions}}'); then
		[[ $INFO == *'"name=rootless"'* ]]
	elif [[ $1 == podman ]] && INFO=$(podman info --format '{{json .Host.Security.Rootless}}'); then
		[[ $INFO == true ]]
	else
		echo "Error: cannot determine whether $1 is rootless."
		exit 1
	fi
}

# True when Docker registers gVisor under the exact name runsc.
has_runsc() {
	usable docker &&
		docker info --format '{{range $k, $v := .Runtimes}}{{$k}}{{"\n"}}{{end}}' 2>/dev/null | grep -qx runsc
}

# Check and resolve path
resolve() {
	RESOLVED="$(realpath "$1")"
	if [ -d "$RESOLVED" ] && [ -r "$RESOLVED" ] && [ -x "$RESOLVED" ]; then
		echo "$RESOLVED"
		return 0
	fi

	exit 1
}

# --------------------------------------------------------------------------

# --------------------------------------------------------------------------
# ------------------------------ CLI Options -------------------------------
# --------------------------------------------------------------------------
# Defaults
IMAGE="ghcr.io/anomalyco/opencode:latest"
PULL=always

CONTAINERIZER=auto
CONTAINER_OPTS=()
GUARD=1
GUARD_FILE=""
GVISOR=0
OPENCODE_OPTS=()

CONFIG_MODE=ro

while [ "$#" -gt 0 ]; do
	case "$1" in
	# Sandbox options
	--no-pull)
		PULL=never
		shift
		;;
	--edit-config)
		CONFIG_MODE=""
		shift
		;;
	--no-network)
		CONTAINER_OPTS+=(--network none)
		shift
		;;
	--no-guard)
		GUARD=0
		shift
		;;
	--gvisor)
		GVISOR=1
		GUARD=0
		shift
		;;

	# Container options
	--runtime=docker | --runtime=podman)
		CONTAINERIZER="${1#*=}"
		shift
		;;
	--container-*=*)
		CONTAINER_OPTS+=("--${1#--container-}")
		shift
		;;

	# Opencode options
	--opencode-*=*)
		OPENCODE_OPTS+=("--${1#--opencode-}")
		shift
		;;

	# Guard options
	--guard=*)
		GUARD_FILE="${1#*=}"
		shift
		;;
	*)
		shift
		;;
	esac
done
# --------------------------------------------------------------------------

# --------------------------------------------------------------------------
# ----------------------- Opencode Sandbox Directories ---------------------
# --------------------------------------------------------------------------
HOME_DIR=$(resolve "$HOME")
CONFIG_DIR=$(resolve "$HOME_DIR/.config/opencode")

# Project Directory
PROJECT=$(resolve $(pwd))
# Block /
if [ "$PROJECT" = "/" ]; then
	echo "Error: refusing to run OpenCode at the filesystem root."
	exit 1
fi
# Block HOME
if within "$HOME_DIR" "$PROJECT"; then
	echo "Error: refusing to run OpenCode here:"
	echo "  $PROJECT"
	echo "It contains your home directory ($HOME_DIR), which would be exposed"
	echo "to the sandbox. Run it inside a more specific project directory."
	exit 1
fi

# State Directory
STATE_DIR="$PROJECT/.opencode-sandbox"
# Check for opencode-project-init
if [ ! -d "$STATE_DIR" ]; then
	echo "Error: this directory has not been initialized for isolated OpenCode."
	echo
	echo "Run:"
	echo "  opencode-project-init"
	exit 1
fi
STATE_DIR=$(resolve $STATE_DIR)
# --------------------------------------------------------------------------

# --------------------------------------------------------------------------
# -------------------- Container Runtime Selection -------------------------
# --------------------------------------------------------------------------
# Set default CONTAINERIZER
if [[ $CONTAINERIZER == auto ]]; then
	# gVisor Docker first, then Podman, then ordinary Docker
	if has_runsc; then
		GVISOR=1
		GUARD=0
		echo "Container(Auto): Docker+gVisor"
		CONTAINERIZER=docker
	elif usable podman; then
		echo "Container(Auto): Podman"
		CONTAINERIZER=podman
	elif usable docker; then
		echo "Container(Auto): Docker"
		CONTAINERIZER=docker
	else
		echo "Error: no usable container runtime was found."
		echo "Install Docker or Podman and start its daemon or service, then run again."
		exit 1
	fi
# An explicit runtime must be usable
elif ! usable "$CONTAINERIZER"; then
	echo "Error: $CONTAINERIZER was selected but is not usable."
	echo "Install the $CONTAINERIZER CLI and start its daemon or service, or drop --runtime=$CONTAINERIZER."
	exit 1
fi

# gVisor is a Docker runtime, so the request needs Docker with runsc.
# Docker is already known usable whenever it was selected, so only
# the runtime registration is left to confirm.
if [[ $GVISOR == 1 ]] && { [[ $CONTAINERIZER != docker ]] || ! has_runsc; }; then
	gvisor_requires_docker
fi

# Locate the guard once the runtime decides whether it is needed
if [[ $GUARD == 1 ]]; then
	if [ -z "$GUARD_FILE" ]; then
		GUARD_FILE="$(dirname -- "$(realpath "${BASH_SOURCE[0]}")")/build/opencode-guard"
		{ [ -f "$GUARD_FILE" ] && [ -x "$GUARD_FILE" ]; } || GUARD_FILE="/usr/lib/opencode-sandbox/guard"
	fi
	if [ ! -f "$GUARD_FILE" ] || [ ! -x "$GUARD_FILE" ]; then
		echo "Error: the sandbox guard is missing or not executable."
		echo "Build it with 'make' next to this launcher, install a package that ships it,"
		echo "or point at a guard binary with --guard=PATH."
		exit 1
	fi
fi
# --------------------------------------------------------------------------

# --------------------------------------------------------------------------
# ------------------------ CONTAINER SPECIFIC SETTINGS ---------------------
# --------------------------------------------------------------------------
# Docker
if [[ $CONTAINERIZER == docker ]]; then
	#gVisor
	if [[ $GVISOR == 1 ]]; then
		CONTAINER_OPTS+=(--runtime runsc)
	fi

	# Security Options
	SEC_OPTS=(--cap-drop ALL --security-opt no-new-privileges:true)

	# Mount options
	NONRECURSIVE=bind-recursive=disabled
	EMPTY_TMPFS=""
# Podman
elif [[ $CONTAINERIZER == podman ]]; then
	# Security Options
	SEC_OPTS=(--cap-drop ALL --security-opt no-new-privileges)
	SEC_OPTS+=(--security-opt mask=/proc/cmdline)
	SEC_OPTS+=(--security-opt mask=/proc/cpuinfo)
	SEC_OPTS+=(--security-opt mask=/proc/meminfo)

	# Mount options
	NONRECURSIVE=bind-nonrecursive
	EMPTY_TMPFS=,notmpcopyup
fi

# Set user config for rootful or rootless runtimes
if rootless "$CONTAINERIZER"; then
	USER_OPTS=(--env HOME=/root)
else
	USER_OPTS=(--user "$(id -u):$(id -g)" --env HOME=/root)
fi

# Add mount volumes
MOUNT_OPTS+=(
	# nothing -> /sys paths
	--mount "type=tmpfs,dst=/sys/devices,readonly,tmpfs-size=4096$EMPTY_TMPFS"
	--mount "type=tmpfs,dst=/sys/module,readonly,tmpfs-size=4096$EMPTY_TMPFS"
	--mount "type=tmpfs,dst=/sys/bus/pci,readonly,tmpfs-size=4096$EMPTY_TMPFS"
	--mount "type=tmpfs,dst=/sys/bus/usb,readonly,tmpfs-size=4096$EMPTY_TMPFS"
	--mount "type=tmpfs,dst=/sys/bus/scsi,readonly,tmpfs-size=4096$EMPTY_TMPFS"
	--mount "type=tmpfs,dst=/sys/block,readonly,tmpfs-size=4096$EMPTY_TMPFS"
	--mount "type=tmpfs,dst=/sys/class/dmi/id,readonly,tmpfs-size=4096$EMPTY_TMPFS"
	--mount "type=tmpfs,dst=/sys/kernel,readonly,tmpfs-size=4096$EMPTY_TMPFS"
	--mount "type=tmpfs,dst=/sys/power,readonly,tmpfs-size=4096$EMPTY_TMPFS"
	--mount "type=tmpfs,dst=/sys/fs/pstore,readonly,tmpfs-size=4096$EMPTY_TMPFS"

	# project -> /workspace
	--mount "type=bind,src=$PROJECT,dst=/workspace,$NONRECURSIVE,bind-propagation=rprivate"

	# state -> .opencode-sandbox
	# nothing -> /workspace/.opencode-sandbox
	--mount "type=bind,src=$STATE_DIR,dst=/root/.local/share/opencode,$NONRECURSIVE,bind-propagation=rprivate"
	--mount "type=tmpfs,dst=/workspace/.opencode-sandbox,readonly,tmpfs-size=4096$EMPTY_TMPFS"

	# config -> /root/.config/opencode
	--mount "type=bind,src=$CONFIG_DIR,dst=/root/.config/opencode,$CONFIG_MODE,$NONRECURSIVE,bind-propagation=rprivate"
)

# Add guard
if [[ $GUARD == 1 ]]; then
	# guard -> /opt/opencode-sandbox/guard
	MOUNT_OPTS+=(--mount "type=bind,src=$GUARD_FILE,dst=/opt/opencode-sandbox/guard,readonly")
	CONTAINER_OPTS+=(--entrypoint /opt/opencode-sandbox/guard)
	CONTAINER_OPTS+=(--env OPENCODE_SANDBOX=1)
fi

CONTAINER_OPTS+=("${USER_OPTS[@]}")
CONTAINER_OPTS+=("${SEC_OPTS[@]}")
CONTAINER_OPTS+=("${MOUNT_OPTS[@]}")
# --------------------------------------------------------------------------

# --------------------------------------------------------------------------
# ---------------------------------- PROMPT --------------------------------
# --------------------------------------------------------------------------
# Present the sandbox summary and request consent
B=
DIM=
GRN=
YEL=
RED=
RST=
if [ -t 0 ] && [ -t 1 ]; then
	B=$'\033[1m'
	DIM=$'\033[2m'
	GRN=$'\033[32m'
	YEL=$'\033[33m'
	RED=$'\033[31m'
	RST=$'\033[0m'
fi

PROJ_NAME="$(basename "$PROJECT")"

cat <<'LOGO'
⠀                                ▄
█▀▀█ █▀▀█ █▀▀█ █▀▀▄ █▀▀▀ █▀▀█ █▀▀█ █▀▀█
█  █ █  █ █▀▀▀ █  █ █    █  █ █  █ █▀▀▀
▀▀▀▀ █▀▀▀ ▀▀▀▀ ▀  ▀ ▀▀▀▀ ▀▀▀▀ ▀▀▀▀ ▀▀▀▀

LOGO
printf '  %s\n' "${GRN}${B}${PROJ_NAME}${RST}${DIM} - isolated session${RST}"
printf '  %-17s %s\n' "${B}Project${RST}" "$PROJECT"
if [ "$GVISOR" -eq 1 ]; then
	printf '  %-17s %s\n' "${B}Runtime${RST}" "$CONTAINERIZER (gVisor runsc)"
else
	printf '  %-17s %s\n' "${B}Runtime${RST}" "$CONTAINERIZER"
fi
printf '  %-17s %s\n' "${B}Image pull${RST}" "$PULL"
if [ -n "${NETWORK:-}" ] && [ "$NETWORK" != "none" ]; then
	printf '  %-17s %s\n' "${B}Network${RST}" "$NETWORK"
elif [[ "${CONTAINER_OPTS[*]}" == *"--network none"* ]]; then
	printf '  %-17s %s\n' "${B}Network${RST}" "none"
else
	printf '  %-17s %s\n' "${B}Network${RST}" "default"
fi
echo
printf '  %-17s %s\n' "${GRN}read/write${RST}" "everything in $PROJECT"
printf '  %-17s %s\n' "${YEL}persistent${RST}" "$STATE_DIR"
if [ "$CONFIG_MODE" = rw ]; then
	printf '  %-17s %s (read/write)\n' "${YEL}config${RST}" "$CONFIG_DIR"
else
	printf '  %-17s %s (read-only)\n' "${YEL}config${RST}" "$CONFIG_DIR"
fi
echo
printf '  %-17s %s\n' "${RED}blocked${RST}" "other projects, your home dir, ~/.ssh, Docker socket"
echo
MEM_LIMIT="${MEM_LIMIT:-4g}"
CPUS_LIMIT="${CPUS_LIMIT:-2}"
PIDS_LIMIT="${PIDS_LIMIT:-1024}"
echo "  ${DIM}Limits: ${MEM_LIMIT} RAM | ${CPUS_LIMIT} CPUs | ${PIDS_LIMIT} processes${RST}"
echo
printf "Continue? [y/N]: "
if ! read -r CONFIRM; then
	echo
	echo "Cancelled."
	exit 0
fi

case "$CONFIRM" in
y | Y | yes | Yes | YES)
	;;
*)
	echo "Cancelled."
	exit 0
	;;
esac
# --------------------------------------------------------------------------

DNS_SERVER="${DNS_SERVER:-1.1.1.1}"
"$CONTAINERIZER" run --init --rm \
	-it \
	--pull "$PULL" \
	--hostname opencode \
	--dns "$DNS_SERVER" \
	--cpus "$(nproc)" \
	--memory "$MEM_LIMIT" \
	--memory-swap "$MEM_LIMIT" \
	--pids-limit "$PIDS_LIMIT" \
	--ulimit core=0 \
	--ipc private \
	--cgroupns private \
	"${CONTAINER_OPTS[@]}" \
	--workdir /workspace \
	"$IMAGE" \
	opencode "${OPENCODE_OPTS[@]}"
