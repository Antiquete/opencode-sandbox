#!/usr/bin/env bash
set -euo pipefail
umask 077

# --------------------------------------------------------------------------
# -------------------------------- Helpers ---------------------------------
# --------------------------------------------------------------------------
# Show ON/OFF switches or a supplied value.
status() {
	case "$2" in
	1 | always) set -- "$1" ON ;;
	0 | never) set -- "$1" OFF ;;
	esac
	printf '  %s:%s\n' "$1" "$2"
}

# True when a path is another path or lives inside it.
within() {
	[ "$1" = "$2" ] || [[ "$1" == "$2/"* ]]
}

# Explain the gVisor requirement and stop.
gvisor_requires_docker() {
	echo "Error: --gvisor needs Docker with a runtime registered under the exact name 'runsc'."
	echo "Install gVisor and add \"runsc\" to the runtimes in /etc/docker/daemon.json,"
	echo "then run again without --runtime podman."
	exit 1
}

# True when a container runtime is installed and its daemon answers.
usable() {
	command -v "$1" >/dev/null 2>&1 && "$1" info >/dev/null 2>&1
}

# True when the runtime is rootless; stop if its identity query fails.
rootless() {
	local INFO
	if [[ $1 == docker ]] && INFO=$(docker info --format '{{json .SecurityOptions}}'); then
		[[ $INFO == *'"name=rootless"'* ]]
	elif [[ $1 == podman ]] && INFO=$(podman info --format '{{json .Host.Security.Rootless}}'); then
		[[ $INFO == true ]]
	else
		echo "Error: cannot determine whether $1 is rootless."
		exit 1
	fi
}

# True when Docker registers gVisor under the exact name runsc.
has_runsc() {
	usable docker &&
		docker info --format '{{range $k, $v := .Runtimes}}{{$k}}{{"\n"}}{{end}}' 2>/dev/null | grep -qx runsc
}

# Resolve into the named variable without trimming path contents.
resolve() {
	if ! IFS= read -r -d '' "$1" < <(realpath -ze -- "$2") ||
		[ ! -r "${!1}" ] || [ ! -x "${!1}" ]; then
		printf 'Error: cannot resolve or access path: %s\n' "$2" >&2
		exit 1
	fi
}

# Encode the complete source field for the runtimes' CSV mount parser.
mount_source() {
	printf '"src=%s"' "${1//\"/\"\"}"
}

# --------------------------------------------------------------------------

# --------------------------------------------------------------------------
# ------------------------------ CLI Options -------------------------------
# --------------------------------------------------------------------------
# Defaults
IMAGE="ghcr.io/anomalyco/opencode:latest"
PULL=always

CONTAINERIZER=auto
CONTAINER_OPTS=()
GUARD=1
GUARD_BIN=""
GVISOR=0
OPENCODE_OPTS=()

CONFIG_MODE="readonly"
MEM_LIMIT=4g
CPUS_LIMIT=2
PIDS_LIMIT=1024
DNS_OPTS=(--dns 1.1.1.1)
NETWORK=default

while [ "$#" -gt 0 ]; do
	case "$1" in
	# Sandbox options
	--no-pull)
		PULL=never
		shift
		;;
	--edit-config)
		CONFIG_MODE=""
		shift
		;;
	--no-network)
		CONTAINER_OPTS+=(--network none)
		NETWORK=none
		shift
		;;
	--no-guard)
		GUARD=0
		shift
		;;
	--gvisor)
		GVISOR=1
		GUARD=0
		shift
		;;

	# Container options
	--runtime=docker | --runtime=podman)
		CONTAINERIZER="${1#*=}"
		shift
		;;
	--container-*=*)
		CONTAINER_OPTS+=("--${1#--container-}")
		case "$1" in
		--container-memory=*) MEM_LIMIT="${1#*=}" ;;
		--container-cpus=*) CPUS_LIMIT="${1#*=}" ;;
		--container-pids-limit=*) PIDS_LIMIT="${1#*=}" ;;
		--container-dns=*) DNS_OPTS=() ;;
		--container-network=*) NETWORK="${1#*=}" ;;
		esac
		shift
		;;

	# Opencode options
	--opencode-*=*)
		OPENCODE_OPTS+=("--${1#--opencode-}")
		shift
		;;

	# Guard options
	--guard=*)
		GUARD_BIN="${1#*=}"
		shift
		;;
	*)
		shift
		;;
	esac
done
# --------------------------------------------------------------------------

# --------------------------------------------------------------------------
# ----------------------- Opencode Sandbox Directories ---------------------
# --------------------------------------------------------------------------
resolve HOME_DIR "$HOME"

# Prepare shared config and initialize ignore rules for read-only startup.
mkdir -p "$HOME_DIR/.config/opencode"
resolve CONFIG_DIR "$HOME_DIR/.config/opencode"
if [[ ! -e $CONFIG_DIR/.gitignore && ! -L $CONFIG_DIR/.gitignore ]]; then
	(
		set -C
		printf '%s' $'node_modules\npackage.json\npackage-lock.json\nbun.lock\n.gitignore' >"$CONFIG_DIR/.gitignore"
	)
fi

# Project Directory
resolve PROJECT .
# Block /
if [ "$PROJECT" = "/" ]; then
	echo "Error: refusing to run OpenCode at the filesystem root."
	exit 1
fi
# Block HOME
if within "$HOME_DIR" "$PROJECT"; then
	echo "Error: refusing to run OpenCode here:"
	echo "  $PROJECT"
	echo "It contains your home directory ($HOME_DIR), which would be exposed"
	echo "to the sandbox. Run it inside a more specific project directory."
	exit 1
fi

# State Directory
STATE_DIR="$PROJECT/.opencode-sandbox"
# Check for opencode-project-init
if [ ! -d "$STATE_DIR" ]; then
	echo "Error: this directory has not been initialized for isolated OpenCode."
	echo
	echo "Run:"
	echo "  opencode-project-init"
	exit 1
fi
resolve STATE_DIR "$STATE_DIR"
# --------------------------------------------------------------------------

# --------------------------------------------------------------------------
# -------------------- Container Runtime Selection -------------------------
# --------------------------------------------------------------------------
# Set default CONTAINERIZER
if [[ $CONTAINERIZER == auto ]]; then
	# Explicit gVisor or rootful gVisor first, then Podman, then Docker
	if has_runsc && { [[ $GVISOR == 1 ]] || ! rootless docker; }; then
		GVISOR=1
		GUARD=0
		echo "Container(Auto): Docker+gVisor"
		CONTAINERIZER=docker
	elif usable podman; then
		echo "Container(Auto): Podman"
		CONTAINERIZER=podman
	elif usable docker; then
		echo "Container(Auto): Docker"
		CONTAINERIZER=docker
	else
		echo "Error: no usable container runtime was found."
		echo "Install Docker or Podman and start its daemon or service, then run again."
		exit 1
	fi
# An explicit runtime must be usable
elif ! usable "$CONTAINERIZER"; then
	echo "Error: $CONTAINERIZER was selected but is not usable."
	echo "Install the $CONTAINERIZER CLI and start its daemon or service, or drop --runtime=$CONTAINERIZER."
	exit 1
fi

# gVisor is a Docker runtime, so the request needs Docker with runsc.
# Docker is already known usable whenever it was selected, so only
# the runtime registration is left to confirm.
if [[ $GVISOR == 1 ]] && { [[ $CONTAINERIZER != docker ]] || ! has_runsc; }; then
	gvisor_requires_docker
fi

# Locate the guard once the runtime decides whether it is needed
if [[ $GUARD == 1 ]]; then
	if [ -z "$GUARD_BIN" ]; then
		resolve GUARD_BIN "${BASH_SOURCE[0]}"
		GUARD_BIN="${GUARD_BIN%/*}/build/opencode-guard"
		[[ -f $GUARD_BIN && -x $GUARD_BIN ]] || GUARD_BIN="/usr/lib/opencode-sandbox/guard"
	fi
	if [[ ! -f $GUARD_BIN || ! -x $GUARD_BIN ]]; then
		echo "Error: the sandbox guard is missing or not executable."
		echo "Build it with 'make' next to this launcher, install a package that ships it,"
		echo "or point at a guard binary with --guard=PATH."
		exit 1
	fi
	resolve GUARD_BIN "$GUARD_BIN"
fi
# --------------------------------------------------------------------------

# --------------------------------------------------------------------------
# ------------------------ CONTAINER SPECIFIC SETTINGS ---------------------
# --------------------------------------------------------------------------
# Docker
if [[ $CONTAINERIZER == docker ]]; then
	#gVisor
	if [[ $GVISOR == 1 ]]; then
		CONTAINER_OPTS+=(--runtime runsc)
	fi

	# Security Options
	SEC_OPTS=(--cap-drop ALL --security-opt no-new-privileges:true)

	# Mount options
	NONRECURSIVE=bind-recursive=disabled
	EMPTY_TMPFS=""
# Podman
elif [[ $CONTAINERIZER == podman ]]; then
	# Podman rejects DNS configuration with no network.
	[[ $NETWORK != none ]] || DNS_OPTS=()
	# Security Options
	SEC_OPTS=(--cap-drop ALL --security-opt no-new-privileges)
	SEC_OPTS+=(--security-opt mask=/proc/cmdline)
	SEC_OPTS+=(--security-opt mask=/proc/cpuinfo)
	SEC_OPTS+=(--security-opt mask=/proc/meminfo)

	# Mount options
	NONRECURSIVE=bind-nonrecursive
	EMPTY_TMPFS=,notmpcopyup
fi

# Set user config for rootful or rootless runtimes
if rootless "$CONTAINERIZER"; then
	USER_OPTS=(--env HOME=/root)
	if [[ $GVISOR == 1 ]]; then
		echo "Warning: rootless gVisor may require --ignore-cgroups; requested memory, CPU, and PID limits are not enforced with that setting."
	fi
else
	# /root is mode 700 in the image, so a non-root uid needs a writable HOME
	# to reach the state and config binds nested underneath it.
	USER_OPTS=(--user "$(id -u):$(id -g)" --env HOME=/root --env XDG_STATE_HOME=/root/.state)
	MOUNT_OPTS+=(--mount "type=tmpfs,dst=/root,tmpfs-mode=1777$EMPTY_TMPFS")
fi

# Add mount volumes
MOUNT_OPTS+=(
	# nothing -> /sys paths
	--mount "type=tmpfs,dst=/sys/devices,readonly,tmpfs-size=4096$EMPTY_TMPFS"
	--mount "type=tmpfs,dst=/sys/module,readonly,tmpfs-size=4096$EMPTY_TMPFS"
	--mount "type=tmpfs,dst=/sys/bus/pci,readonly,tmpfs-size=4096$EMPTY_TMPFS"
	--mount "type=tmpfs,dst=/sys/bus/usb,readonly,tmpfs-size=4096$EMPTY_TMPFS"
	--mount "type=tmpfs,dst=/sys/bus/scsi,readonly,tmpfs-size=4096$EMPTY_TMPFS"
	--mount "type=tmpfs,dst=/sys/block,readonly,tmpfs-size=4096$EMPTY_TMPFS"
	--mount "type=tmpfs,dst=/sys/kernel,readonly,tmpfs-size=4096$EMPTY_TMPFS"
	--mount "type=tmpfs,dst=/sys/power,readonly,tmpfs-size=4096$EMPTY_TMPFS"
	--mount "type=tmpfs,dst=/sys/fs/pstore,readonly,tmpfs-size=4096$EMPTY_TMPFS"

	# project -> /workspace
	--mount "type=bind,$(mount_source "$PROJECT"),dst=/workspace,$NONRECURSIVE,bind-propagation=rprivate"

	# state -> .opencode-sandbox
	# nothing -> /workspace/.opencode-sandbox
	--mount "type=bind,$(mount_source "$STATE_DIR"),dst=/root/.local/share/opencode,$NONRECURSIVE,bind-propagation=rprivate"
	--mount "type=tmpfs,dst=/workspace/.opencode-sandbox,readonly,tmpfs-size=4096$EMPTY_TMPFS"

	# config -> /root/.config/opencode
	--mount "type=bind,$(mount_source "$CONFIG_DIR"),dst=/root/.config/opencode,${CONFIG_MODE:+$CONFIG_MODE,}$NONRECURSIVE,bind-propagation=rprivate"
)

# gVisor's DMI symlink points into the already masked /sys/devices tree.
[[ $GVISOR == 1 ]] || MOUNT_OPTS+=(--mount "type=tmpfs,dst=/sys/class/dmi/id,readonly,tmpfs-size=4096$EMPTY_TMPFS")

# Add guard
if [[ $GUARD == 1 ]]; then
	# guard -> /opt/opencode-sandbox/guard
	MOUNT_OPTS+=(--mount "type=bind,$(mount_source "$GUARD_BIN"),dst=/opt/opencode-sandbox/guard,readonly")
	CONTAINER_OPTS+=(--entrypoint /opt/opencode-sandbox/guard)
	CONTAINER_OPTS+=(--env OPENCODE_SANDBOX=1)
	OPENCODE_OPTS=(opencode "${OPENCODE_OPTS[@]}")
fi

CONTAINER_OPTS+=("${USER_OPTS[@]}")
CONTAINER_OPTS+=("${SEC_OPTS[@]}")
CONTAINER_OPTS+=("${MOUNT_OPTS[@]}")
# --------------------------------------------------------------------------

# --------------------------------------------------------------------------
# ---------------------------------- PROMPT --------------------------------
# --------------------------------------------------------------------------
# Present the sandbox summary and request consent
DIM=
GRN=
YEL=
RST=
if [ -t 0 ] && [ -t 1 ]; then
	DIM=$'\033[2m'
	GRN=$'\033[32m'
	YEL=$'\033[33m'
	RST=$'\033[0m'
fi

cat <<'LOGO'
⠀                                ▄
█▀▀█ █▀▀█ █▀▀█ █▀▀▄ █▀▀▀ █▀▀█ █▀▀█ █▀▀█
█  █ █  █ █▀▀▀ █  █ █    █  █ █  █ █▀▀▀
▀▀▀▀ █▀▀▀ ▀▀▀▀ ▀  ▀ ▀▀▀▀ ▀▀▀▀ ▀▀▀▀ ▀▀▀▀

LOGO
status Runtime "$CONTAINERIZER"
status gVisor "$GVISOR"
status "Image pull" "$PULL"
[[ $NETWORK == none ]] && status Network 0 || status Network 1
[[ $NETWORK == none || $NETWORK == default ]] || status "Network request" "$NETWORK"
status Guard "$GUARD"
[[ $GUARD == 0 ]] || status "Guard binary" "$GUARD_BIN"
[[ -z $CONFIG_MODE ]] && status "Edit config" 1 || status "Edit config" 0
echo
status "${GRN}Project${RST}" "$PROJECT (read/write)"
status "${YEL}State${RST}" "$STATE_DIR (read/write)"
status Config "$CONFIG_DIR"
echo
status "${DIM}Limits (requested)" "${MEM_LIMIT} RAM | ${CPUS_LIMIT} CPUs | ${PIDS_LIMIT} processes${RST}"
echo
printf "Continue? [y/N]: "
if ! read -r CONFIRM; then
	echo
	echo "Cancelled."
	exit 0
fi

case "$CONFIRM" in
y | Y | yes | Yes | YES)
	;;
*)
	echo "Cancelled."
	exit 0
	;;
esac
# --------------------------------------------------------------------------

"$CONTAINERIZER" run --init --rm \
	-it \
	--pull "$PULL" \
	--hostname opencode \
	"${DNS_OPTS[@]}" \
	--cpus "$CPUS_LIMIT" \
	--memory "$MEM_LIMIT" \
	--memory-swap "$MEM_LIMIT" \
	--pids-limit "$PIDS_LIMIT" \
	--ulimit core=0 \
	--ipc private \
	--cgroupns private \
	--env "OPENCODE_GUARD_MEMORY=$MEM_LIMIT" \
	"${CONTAINER_OPTS[@]}" \
	--workdir /workspace \
	"$IMAGE" \
	"${OPENCODE_OPTS[@]}"
