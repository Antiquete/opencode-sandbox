#!/usr/bin/env bash
set -euo pipefail
umask 077

PROJECT="$(cd -P "$PWD" && pwd)"
HOME_DIR="$(cd -P "$HOME" && pwd)"

# Refuse locations that would expose the home directory
if [ "$PROJECT" = "/" ]; then
	echo "Error: refusing to initialize OpenCode at the filesystem root."
	exit 1
fi
if [ "$HOME_DIR" = "$PROJECT" ] || { case "$HOME_DIR" in "$PROJECT"/*) true ;; *) false ;; esac } then
	echo "Error: refusing to initialize OpenCode here:"
	echo "  $PROJECT"
	echo "It contains your home directory ($HOME_DIR), which would be exposed"
	echo "to the sandbox. Run it inside a more specific project directory."
	exit 1
fi

if [ ! -d "$PROJECT" ]; then
	echo "Error: current directory is invalid."
	exit 1
fi

# Create the private session store
STATE_DIR="$PROJECT/.opencode-sandbox"
if [ -L "$STATE_DIR" ]; then
	echo "Error: $STATE_DIR must be a real directory, not a symlink."
	exit 1
fi
if [ -e "$STATE_DIR" ] && [ ! -d "$STATE_DIR" ]; then
	echo "Error: $STATE_DIR exists but is not a directory."
	exit 1
fi

if [ ! -e "$STATE_DIR" ]; then
	mkdir -p -- "$STATE_DIR"
	chmod 0700 -- "$STATE_DIR"
fi

# Register the store in .gitignore
IGNORE_ENTRY='.opencode-sandbox/'
GITIGNORE_STATUS="skipped (not a git repo)"
if [ -e "$PROJECT/.git" ]; then
	GITIGNORE="$PROJECT/.gitignore"
	if [ -L "$GITIGNORE" ]; then
		echo "Error: $GITIGNORE is a symlink; refusing to write through it."
		exit 1
	fi
	if [ -e "$GITIGNORE" ] && [ ! -f "$GITIGNORE" ]; then
		echo "Error: $GITIGNORE exists but is not a regular file."
		exit 1
	fi
	if [ ! -e "$GITIGNORE" ]; then
		printf '%s\n' "$IGNORE_ENTRY" >"$GITIGNORE"
		GITIGNORE_STATUS="added $IGNORE_ENTRY"
	elif ! grep -qxF "$IGNORE_ENTRY" "$GITIGNORE" 2>/dev/null; then
		TMP_IGNORE="$(mktemp "$PROJECT/.gitignore.tmp.XXXXXXXX")"
		if [ -s "$GITIGNORE" ] && [ "$(tail -c1 "$GITIGNORE")" != $'\n' ]; then
			{
				cat -- "$GITIGNORE"
				printf '\n'
			} >"$TMP_IGNORE"
		else
			cat -- "$GITIGNORE" >"$TMP_IGNORE"
		fi
		printf '%s\n' "$IGNORE_ENTRY" >>"$TMP_IGNORE"
		chmod "$(stat -c %a -- "$GITIGNORE")" -- "$TMP_IGNORE"
		mv -- "$TMP_IGNORE" "$GITIGNORE"
		GITIGNORE_STATUS="added $IGNORE_ENTRY"
	else
		GITIGNORE_STATUS="already ignored"
	fi
fi

# Show the result
B=
DIM=
GRN=
RST=
if [ -t 0 ] && [ -t 1 ]; then
	B=$'\033[1m'
	DIM=$'\033[2m'
	GRN=$'\033[32m'
	RST=$'\033[0m'
fi

PROJ_NAME="$(basename "$PROJECT")"

cat <<'LOGO'
⠀                                ▄     
█▀▀█ █▀▀█ █▀▀█ █▀▀▄ █▀▀▀ █▀▀█ █▀▀█ █▀▀█
█  █ █  █ █▀▀▀ █  █ █    █  █ █  █ █▀▀▀
▀▀▀▀ █▀▀▀ ▀▀▀▀ ▀  ▀ ▀▀▀▀ ▀▀▀▀ ▀▀▀▀ ▀▀▀▀

LOGO
printf '  %s\n' "${GRN}${B}${PROJ_NAME}${RST}${DIM} - project initialized${RST}"
printf '  %-17s %s\n' "${B}Project${RST}" "$PROJECT"
printf '  %-17s %s\n' "${B}State${RST}" "$PROJECT/.opencode-sandbox"
printf '  %-17s %s\n' "${B}gitignore${RST}" "$GITIGNORE_STATUS"
echo
echo "  ${GRN}Next${RST}: start an isolated session from this directory:"
echo
echo "    opencode-sandbox"
echo
echo "  ${DIM}Args are passed straight through, e.g.:"
echo "    opencode-sandbox --model some-model run \"do the thing\"${RST}"
