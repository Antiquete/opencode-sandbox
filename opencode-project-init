#!/usr/bin/env bash
set -euo pipefail
umask 077

status() {
	printf '  %s:%s\n' "$1" "$2"
}

within() {
	[ "$1" = "$2" ] || [[ "$1" == "$2/"* ]]
}

resolve() {
	if ! IFS= read -r -d '' "$1" < <(realpath -ze -- "$2") ||
		[ ! -r "${!1}" ] || [ ! -x "${!1}" ]; then
		printf 'Error: cannot resolve or access path: %s\n' "$2" >&2
		exit 1
	fi
}

resolve PROJECT .
resolve HOME_DIR "$HOME"

# Refuse locations that would expose the home directory
if [ "$PROJECT" = "/" ]; then
	echo "Error: refusing to initialize OpenCode at the filesystem root."
	exit 1
fi
if within "$HOME_DIR" "$PROJECT"; then
	echo "Error: refusing to initialize OpenCode here:"
	echo "  $PROJECT"
	echo "It contains your home directory ($HOME_DIR), which would be exposed"
	echo "to the sandbox. Run it inside a more specific project directory."
	exit 1
fi

# Create the private session store
STATE_DIR="$PROJECT/.opencode-sandbox"
if { [ -e "$STATE_DIR" ] || [ -L "$STATE_DIR" ]; } && [ ! -d "$STATE_DIR" ]; then
	echo "Error: $STATE_DIR exists but is not a directory."
	exit 1
fi

if [ ! -e "$STATE_DIR" ]; then
	mkdir -p -- "$STATE_DIR"
	chmod 0700 -- "$STATE_DIR"
fi

# Show the result
GRN=
RST=
if [ -t 0 ] && [ -t 1 ]; then
	GRN=$'\033[32m'
	RST=$'\033[0m'
fi

cat <<'LOGO'
⠀                                ▄     
█▀▀█ █▀▀█ █▀▀█ █▀▀▄ █▀▀▀ █▀▀█ █▀▀█ █▀▀█
█  █ █  █ █▀▀▀ █  █ █    █  █ █  █ █▀▀▀
▀▀▀▀ █▀▀▀ ▀▀▀▀ ▀  ▀ ▀▀▀▀ ▀▀▀▀ ▀▀▀▀ ▀▀▀▀

LOGO
status "${GRN}Project${RST}" "$PROJECT"
status State "$STATE_DIR"
status gitignore 'Add .opencode-sandbox/ to your ignore rules'
echo
status Next opencode-sandbox
status Example 'opencode-sandbox --opencode-model=some-model'
